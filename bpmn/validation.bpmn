      <bpmndi:BPMNShape id="S2_di" bpmnElement="S2"><dc:Bounds x="112.0" y="527.0" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_all_di" bpmnElement="T_all"><dc:Bounds x="218.0" y="507.0" width="124" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_all_di" bpmnElement="G_all" isMarkerVisible="true"><dc:Bounds x="407.0" y="522.0" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_pass_di" bpmnElement="T_pass"><dc:Bounds x="518.0" y="507.0" width="124" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="712.0" y="527.0" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_stop_di" bpmnElement="T_stop"><dc:Bounds x="518.0" y="627.0" width="124" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E3_di" bpmnElement="E3"><dc:Bounds x="732.0" y="647.0" width="36" height="36"/></bpmndi:BPMNShape>
